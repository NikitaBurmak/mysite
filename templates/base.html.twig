<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Anecdotes{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="icon" href="{{ asset('anecdots.ico') }}" type="image/x-icon">
</head>
<body>
<header>
    <h3>Anecdotes</h3>
    {% if app.user %}
        <div id="userAvatar" class="user-menu">
            <div class="user-avatar">👤</div>
            <div class="dropdown">
                <a href="{{ path('app_logout') }}" id="logoutButton">Exit</a>
            </div>
        </div>
    {% else %}
        <button id="loginButton">Entrance</button>
    {% endif %}
    <meta name="csrf-token" content="{{ csrf_token('vote') }}">
</header>

{% block body %}{% endblock %}

<footer>
    &copy; {{ "now"|date("Y") }} Anecdotes. All rights reserved.
</footer>

{% block javascripts %}
    <script>
        window.IS_LOGGED_IN = {{ app.user ? 'true' : 'false' }};
        window.CURRENT_USER = {{ app.user ? app.user.id : 'null' }};
    </script>
    <script src="{{ asset('js/main.js') }}" type="module"></script>
    <script src="{{ asset('js/admin/admin.js') }}" type="module"></script>
{% endblock %}
</body>
</html>
