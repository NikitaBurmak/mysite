<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Anecdotes{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('css/profile.css') }}">
    <link rel="icon" href="{{ asset('anecdots.ico') }}" type="image/x-icon">
</head>
<body>
<header>
    <h3>Anecdotes</h3>
    {% if app.user %}
        <a href="{{ path('profile') }}" class="user-avatar-link">
            <div class="user-avatar">
                {% if app.user.avatarPath %}
                    <img src="{{ asset(app.user.avatarPath) }}" alt="avatar">
                {% else %}
                    👤
                {% endif %}
            </div>
        </a>
    {% else %}
        <button id="loginButton">Entrance</button>
    {% endif %}
    <meta name="csrf-token" content="{{ csrf_token('vote') }}">
</header>

<main>
    {% block body %}{% endblock %}
</main>

<footer>
    &copy; {{ "now"|date("Y") }} Anecdotes. All rights reserved.
</footer>

{% block javascripts %}
    <script>
        window.IS_LOGGED_IN = {{ app.user ? 'true' : 'false' }};
        window.CURRENT_USER = {{ app.user ? app.user.id : 'null' }};
    </script>
    <script type="module" src="{{ asset('js/profile.js') }}"></script>
    <script type="module" src="{{ asset('js/main.js') }}"></script>
{% endblock %}
</body>
</html>
