<div id="addAnecdoteModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <form id="addAnecdoteForm" data-url="{{ path('api_anecdotes_create') }}">
            <textarea name="text" placeholder="Ваш анекдот" required></textarea>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_anecdote') }}">

            <div class="topics-select">
                <p class="topics-label">Выберите темы:</p>
                <div class="topics-checkboxes">
                    {% for topic in topics %}
                        <label class="topic-checkbox">
                            <input type="checkbox" name="topicIds[]" value="{{ topic.id }}">
                            <span>{{ topic.name }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            <button type="submit">Добавить</button>
        </form>
    </div>
</div>
