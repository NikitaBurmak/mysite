{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
    <div class="main-container">

        <div class="sidebar">
            <h3 class="text-lg font-bold mb-4">Topics of jokes</h3>
            <div id="topicsContainer" class="flex flex-col gap-2"></div>
        </div>

        <div class="content">
            <table class="min-w-full bg-white rounded-lg shadow overflow-hidden">
                <thead class="bg-gray-200">
                <tr>
                    <th class="px-6 py-3 text-left text-gray-700">ID</th>
                    <th class="px-6 py-3 text-left text-gray-700">Joke</th>
                    <th class="px-6 py-3 text-left text-gray-700">Action</th>
                </tr>
                </thead>
                <tbody id="anecdotesTableBody"
                       class="divide-y divide-gray-200">
                </tbody>
            </table>

            <div class="mt-4">
                <button id="addAnecdoteButton" class="add-btn">
                    Add a joke
                </button>
            </div>
        </div>

    </div>

    {% include 'partials/_auth_modal.html.twig' %}
    {% include 'partials/_add_anecdote_modal.html.twig' %}
{% endblock %}
